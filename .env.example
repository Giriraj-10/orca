# ORCA Environment Configuration
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/orca
JWT_SECRET=orca_jwt_secret_dev_key_secure_marine_agents_9921

# Data Mode: 'live', 'hybrid' (Live -> Cache -> Demo), or 'demo'
DATA_MODE=hybrid

# AI Engine (Optional - deterministic fallback engine runs if omitted)
GEMINI_API_KEY=

# Indian Meteorological Department (IMD)
IMD_API_KEY=
IMD_API_BASE_URL=

# MOSDAC (ISRO Earth Observation)
MOSDAC_USERNAME=
MOSDAC_PASSWORD=
MOSDAC_BASE_URL=https://www.mosdac.gov.in

# INCOIS (Indian National Centre for Ocean Information Services)
INCOIS_API_BASE_URL=https://incois.gov.in

# Open-Meteo Marine & Weather APIs (No API key needed)
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_MARINE_BASE_URL=https://marine-api.open-meteo.com

# OpenStreetMap Nominatim Geocoding
OSM_BASE_URL=https://nominatim.openstreetmap.org

# Cache & Network Resilience
CACHE_TTL_SECONDS=900
API_TIMEOUT_MS=10000
